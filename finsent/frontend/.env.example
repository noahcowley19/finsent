# =============================================================================
# FINSENT FRONTEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
# The URL of your Flask backend API
# For local development: http://localhost:5000
# For production: Your deployed backend URL (e.g., Render, Railway, etc.)
NEXT_PUBLIC_API_URL=https://finsent-backend.onrender.com

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL database connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Required for Prisma to work
# For local development, you can use a local PostgreSQL instance
# For production (Netlify), this should point to your hosted database
DATABASE_URL=postgresql://user:password@localhost:5432/finsent

# -----------------------------------------------------------------------------
# NextAuth Configuration
# -----------------------------------------------------------------------------
# Secret used for encrypting JWT tokens and other sensitive data
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# The canonical URL of your site (required for NextAuth)
# For local development: http://localhost:3000
# For production: https://your-netlify-site.netlify.app
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Optional: Email Configuration (for password reset)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@yourdomain.com
